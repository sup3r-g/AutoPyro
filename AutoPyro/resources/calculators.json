{
    "TransformationRatio": {
        "column_name": "TR",
        "classes": {
            "Espitalie, 1987": "(HI_o - HI) * 1200 / HI_o * (1200 - HI)",
            "Peters, 2005": "1 - (HI * TOC * (p - TOC_o)) / (HI_o * TOC_o * (p - TOC))"
        }
    },
    "HIo": {
        "column_name": "HIo",
        "selector": "MATTER TYPE",
        "classes": {
            "Cornford, 2001": "HI + HI * (T_max - 435) / 30"
        }
    },
    "TOCo": {
        "column_name": "TOCo",
        "selector": "MATTER TYPE",
        "classes": {
            "Peters, 2005": "p * HI * TOC / (HI_o * (1 - TR / 100) * (p - TOC) + HI * TOC)",
            "Neruchev, 1998": ""
        }
    }
}