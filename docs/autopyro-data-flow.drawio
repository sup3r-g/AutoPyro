        <mxCell id="subtitle" value="&lt;b&gt;Какие данные загрузить → где работать → что получить&lt;/b&gt;" style="text;align=left;spacing=0;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="73" width="1280" height="34" as="geometry"/></mxCell>
        <mxCell id="files" value="&lt;b&gt;Excel (.xlsx), CSV / TSV&lt;/b&gt;&lt;br&gt;Файл → Импорт Excel / CSV" style="rounded=1;arcSize=12;fillColor=#EAF3FC;strokeColor=#A8C4DF;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="128" width="380" height="85" as="geometry"/></mxCell>
        <mxCell id="db" value="&lt;b&gt;Геохимическая база данных&lt;/b&gt;&lt;br&gt;Файл → Импорт геохимии из БД" style="rounded=1;arcSize=12;fillColor=#EAF3FC;strokeColor=#A8C4DF;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="229" width="380" height="85" as="geometry"/></mxCell>
        <mxCell id="table" value="&lt;b&gt;Таблица&lt;/b&gt;&lt;br&gt;Выберите пробы по скважине, глубине, интервалу или другим колонкам." style="rounded=1;arcSize=12;fillColor=#F0ECFA;strokeColor=#C5B8E1;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="480" y="169" width="400" height="105" as="geometry"/></mxCell>
        <mxCell id="selection" value="&lt;b&gt;Выборка проб&lt;/b&gt;&lt;br&gt;Используйте её в инструментах ниже. Дополнительные слои и схемы подключаются в соответствующих инструментах." style="rounded=1;arcSize=12;fillColor=#E9F5EE;strokeColor=#AACDB7;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="940" y="169" width="380" height="105" as="geometry"/></mxCell>
        <mxCell id="ef" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#58738C;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="files" target="table"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#58738C;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="db" target="table"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="es" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#58738C;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="table" target="selection"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="header0" value="&lt;b&gt;ДАННЫЕ ДЛЯ ЗАДАЧИ&lt;/b&gt;" style="rounded=1;arcSize=12;fillColor=#173454;strokeColor=none;fontColor=#FFFFFF;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=18;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="345" width="380" height="46" as="geometry"/></mxCell>
        <mxCell id="header1" value="&lt;b&gt;ГДЕ РАБОТАТЬ&lt;/b&gt;" style="rounded=1;arcSize=12;fillColor=#173454;strokeColor=none;fontColor=#FFFFFF;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=18;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="480" y="345" width="400" height="46" as="geometry"/></mxCell>
        <mxCell id="header2" value="&lt;b&gt;РЕЗУЛЬТАТ&lt;/b&gt;" style="rounded=1;arcSize=12;fillColor=#173454;strokeColor=none;fontColor=#FFFFFF;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=18;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="940" y="345" width="380" height="46" as="geometry"/></mxCell>
        <mxCell id="data0" value="&lt;b&gt;Исходные и повторные измерения&lt;/b&gt;&lt;br&gt;Лабораторные результаты, значения ниже предела определения, повторы." style="rounded=1;arcSize=12;fillColor=#EAF3FC;strokeColor=#A8C4DF;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="409" width="380" height="104" as="geometry"/></mxCell>
        <mxCell id="work0" value="&lt;b&gt;Таблица и Контроль качества&lt;/b&gt;&lt;br&gt;Правка → Измерения выбранной ячейки&lt;br&gt;Обработка → Контроль качества" style="rounded=1;arcSize=12;fillColor=#F0ECFA;strokeColor=#C5B8E1;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="480" y="409" width="400" height="104" as="geometry"/></mxCell>
        <mxCell id="out0" value="&lt;b&gt;Подготовленная выборка&lt;/b&gt;&lt;br&gt;Рабочие значения, замечания к данным и исключения из анализа." style="rounded=1;arcSize=12;fillColor=#E9F5EE;strokeColor=#AACDB7;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="940" y="409" width="380" height="104" as="geometry"/></mxCell>
        <mxCell id="a0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#58738C;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="data0" target="work0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#58738C;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="work0" target="out0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="data1" value="&lt;b&gt;Данные пиролиза&lt;/b&gt;&lt;br&gt;TOC, S1, S2, S3 и Tmax. Для расчёта выбирают нужные исходные показатели и единицы." style="rounded=1;arcSize=12;fillColor=#EAF3FC;strokeColor=#A8C4DF;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="533" width="380" height="104" as="geometry"/></mxCell>
        <mxCell id="work1" value="&lt;b&gt;Расчёты пиролиза&lt;/b&gt;&lt;br&gt;Обработка → Расчёты пиролиза" style="rounded=1;arcSize=12;fillColor=#F0ECFA;strokeColor=#C5B8E1;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="480" y="533" width="400" height="104" as="geometry"/></mxCell>
        <mxCell id="out1" value="&lt;b&gt;Показатели пиролиза&lt;/b&gt;&lt;br&gt;HI, OI, PI и GP. Результаты можно добавить в таблицу отдельными колонками." style="rounded=1;arcSize=12;fillColor=#E9F5EE;strokeColor=#AACDB7;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="940" y="533" width="380" height="104" as="geometry"/></mxCell>
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#58738C;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="data1" target="work1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#58738C;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="work1" target="out1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="data2" value="&lt;b&gt;Другие геохимические данные&lt;/b&gt;&lt;br&gt;Витринит, газы и их изотопы, SARA, элементный состав, хроматографические показатели." style="rounded=1;arcSize=12;fillColor=#EAF3FC;strokeColor=#A8C4DF;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="657" width="380" height="104" as="geometry"/></mxCell>
        <mxCell id="work2" value="&lt;b&gt;Геохимия&lt;/b&gt;&lt;br&gt;Обработка → Геохимия → Паспорта и сравнение проб или нужная методика" style="rounded=1;arcSize=12;fillColor=#F0ECFA;strokeColor=#C5B8E1;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="480" y="657" width="400" height="104" as="geometry"/></mxCell>
        <mxCell id="out2" value="&lt;b&gt;Паспорта и сравнение проб&lt;/b&gt;&lt;br&gt;Анализы и повторы, таблицы и графики сравнения, результаты выбранной методики." style="rounded=1;arcSize=12;fillColor=#E9F5EE;strokeColor=#AACDB7;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="940" y="657" width="380" height="104" as="geometry"/></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#58738C;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="data2" target="work2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#58738C;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="work2" target="out2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="data3" value="&lt;b&gt;Числовые показатели и группы проб&lt;/b&gt;&lt;br&gt;Например, HI и Tmax по скважинам или стратиграфическим подразделениям." style="rounded=1;arcSize=12;fillColor=#EAF3FC;strokeColor=#A8C4DF;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="781" width="380" height="104" as="geometry"/></mxCell>
        <mxCell id="work3" value="&lt;b&gt;Статистика, Графики, Подгонка кривых&lt;/b&gt;&lt;br&gt;Команды в меню «Обработка»" style="rounded=1;arcSize=12;fillColor=#F0ECFA;strokeColor=#C5B8E1;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="480" y="781" width="400" height="104" as="geometry"/></mxCell>
        <mxCell id="out3" value="&lt;b&gt;Сравнение и модели&lt;/b&gt;&lt;br&gt;Сводки, корреляции, возможные выбросы, графики, коэффициенты и качество подгонки." style="rounded=1;arcSize=12;fillColor=#E9F5EE;strokeColor=#AACDB7;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="940" y="781" width="380" height="104" as="geometry"/></mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#58738C;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="data3" target="work3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#58738C;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="work3" target="out3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="data4" value="&lt;b&gt;Два показателя и схема&lt;/b&gt;&lt;br&gt;Например, два показателя пиролиза и схема с заданными областями." style="rounded=1;arcSize=12;fillColor=#EAF3FC;strokeColor=#A8C4DF;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="905" width="380" height="104" as="geometry"/></mxCell>
        <mxCell id="work4" value="&lt;b&gt;Интерпретация&lt;/b&gt;&lt;br&gt;Обработка → Интерпретация" style="rounded=1;arcSize=12;fillColor=#F0ECFA;strokeColor=#C5B8E1;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="480" y="905" width="400" height="104" as="geometry"/></mxCell>
        <mxCell id="out4" value="&lt;b&gt;Классификация проб&lt;/b&gt;&lt;br&gt;Положение проб на схеме и принадлежность к её областям." style="rounded=1;arcSize=12;fillColor=#E9F5EE;strokeColor=#AACDB7;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="940" y="905" width="380" height="104" as="geometry"/></mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#58738C;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="data4" target="work4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#58738C;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="work4" target="out4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="data5" value="&lt;b&gt;Глубины и стратиграфические интервалы&lt;/b&gt;&lt;br&gt;Скважина, глубина или интервал пробы и стратиграфическая разбивка." style="rounded=1;arcSize=12;fillColor=#EAF3FC;strokeColor=#A8C4DF;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="1029" width="380" height="104" as="geometry"/></mxCell>
        <mxCell id="work5" value="&lt;b&gt;Стратиграфия&lt;/b&gt;&lt;br&gt;Обработка → Стратиграфия" style="rounded=1;arcSize=12;fillColor=#F0ECFA;strokeColor=#C5B8E1;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="480" y="1029" width="400" height="104" as="geometry"/></mxCell>
        <mxCell id="out5" value="&lt;b&gt;Стратиграфическая привязка&lt;/b&gt;&lt;br&gt;Принадлежность проб к подразделениям и стратиграфические колонки." style="rounded=1;arcSize=12;fillColor=#E9F5EE;strokeColor=#AACDB7;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="940" y="1029" width="380" height="104" as="geometry"/></mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#58738C;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="data5" target="work5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#58738C;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="work5" target="out5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="data6" value="&lt;b&gt;Профиль с пропусками&lt;/b&gt;&lt;br&gt;Глубина или другая координата, измеренный показатель и группы сопоставимых проб." style="rounded=1;arcSize=12;fillColor=#EAF3FC;strokeColor=#A8C4DF;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="1153" width="380" height="104" as="geometry"/></mxCell>
        <mxCell id="work6" value="&lt;b&gt;Интерполяция&lt;/b&gt;&lt;br&gt;Обработка → Интерполяция" style="rounded=1;arcSize=12;fillColor=#F0ECFA;strokeColor=#C5B8E1;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="480" y="1153" width="400" height="104" as="geometry"/></mxCell>
        <mxCell id="out6" value="&lt;b&gt;Оценки внутри профиля&lt;/b&gt;&lt;br&gt;Расчётные значения для внутренних пропусков в отдельной колонке." style="rounded=1;arcSize=12;fillColor=#E9F5EE;strokeColor=#AACDB7;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="940" y="1153" width="380" height="104" as="geometry"/></mxCell>
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#58738C;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="data6" target="work6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#58738C;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="work6" target="out6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="data7" value="&lt;b&gt;Координаты и картографические слои&lt;/b&gt;&lt;br&gt;Координаты проб или скважин, геохимический показатель, границы регионов." style="rounded=1;arcSize=12;fillColor=#EAF3FC;strokeColor=#A8C4DF;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="1277" width="380" height="104" as="geometry"/></mxCell>
        <mxCell id="work7" value="&lt;b&gt;Карты&lt;/b&gt;&lt;br&gt;Обработка → Карты" style="rounded=1;arcSize=12;fillColor=#F0ECFA;strokeColor=#C5B8E1;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="480" y="1277" width="400" height="104" as="geometry"/></mxCell>
        <mxCell id="out7" value="&lt;b&gt;Карты и пространственные оценки&lt;/b&gt;&lt;br&gt;Расположение проб, сравнение по регионам, пространственная интерполяция." style="rounded=1;arcSize=12;fillColor=#E9F5EE;strokeColor=#AACDB7;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="940" y="1277" width="380" height="104" as="geometry"/></mxCell>
        <mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#58738C;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="data7" target="work7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#58738C;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="work7" target="out7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="data8" value="&lt;b&gt;Выбранные пробы и результаты&lt;/b&gt;&lt;br&gt;Текущая таблица либо данные, статистика и рисунки для отчёта." style="rounded=1;arcSize=12;fillColor=#EAF3FC;strokeColor=#A8C4DF;html=1;whiteSpace=wrap;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#183153;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="40" y="1401" width="380" height="104" as="geometry"/></mxCell>
